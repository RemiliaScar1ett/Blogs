{
  "name": "article-bundle-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/copy_bundle_assets.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "publish": "python scripts/publish.py",
    "new": "python scripts/new_draft.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "astro": "7.1.6",
    "katex": "0.18.1",
    "pagefind": "1.5.2",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
