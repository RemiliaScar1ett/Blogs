---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/article.css';
import type { RenderAsset } from '../core/types';
import { withBase } from '../lib/paths';
import { SITE } from '../config';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  assets?: RenderAsset[];
}
const { title, description = SITE.description, noindex = false, assets = [] } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const entrypoints = [...new Map(assets.filter((a) => a.entrypoint).map((a) => [a.outputPath, a])).values()];
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('theme'); } catch {}
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved : (systemDark ? 'dark' : 'light');
      })();
    </script>
    {entrypoints.filter((a) => a.kind === 'style').map((a) => <link rel="stylesheet" href={withBase(a.outputPath)} />)}
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <SearchModal />
    <BackToTop />
    {entrypoints.filter((a) => a.kind === 'script').map((a) => <script is:inline type="module" src={withBase(a.outputPath)}></script>)}
  </body>
</html>
