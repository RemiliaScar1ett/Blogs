<button class="back-to-top" type="button" data-back-to-top aria-label="回到顶部" title="回到顶部">↑</button>
<script>
  const button = document.querySelector<HTMLElement>('[data-back-to-top]');
  const sync = () => button?.classList.toggle('visible', window.scrollY > 600);
  window.addEventListener('scroll', sync, { passive: true });
  button?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  sync();
</script>
