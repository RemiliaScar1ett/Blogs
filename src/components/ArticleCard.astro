---
import type { ArticleEntry } from '../lib/articles';
import { articleUrl, formatDate, plainSummary, dateLabel } from '../lib/articles';
import TagBadge from './TagBadge.astro';
interface Props { article: ArticleEntry; compact?: boolean }
const { article, compact = false } = Astro.props;
---

<article class:list={['article-card', { 'article-card--compact': compact }]}>
  <div class="article-card__path">{article.data.tree.join(' / ')}</div>
  <h2 class="article-card__title"><a href={articleUrl(article)}>{article.data.title}</a></h2>
  <div class="article-card__meta">
    <time datetime={article.data.publishedAt ?? article.data.date}>{dateLabel(article)} {formatDate(article.data.date)}</time>
    {article.data.updated && <span>更新 {formatDate(article.data.updated)}</span>}
  </div>
  {!compact && <p class="article-card__summary">{plainSummary(article)}</p>}
  <div class="article-card__footer">
    <div class="article-card__tags">
      {article.data.tags.slice(0, compact ? 3 : 6).map((tag) => <TagBadge tag={tag} />)}
    </div>
    <a class="article-card__more" href={articleUrl(article)}>阅读全文</a>
  </div>
</article>
