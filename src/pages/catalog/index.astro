---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CatalogTree from '../../components/CatalogTree.astro';
import { getArticles } from '../../lib/articles';
import { buildArticleTree } from '../../lib/tree';
const articles = await getArticles();
const tree = buildArticleTree(articles);
---
<BaseLayout title="目录" description="按主题浏览全部文章。">
  <Hero title="文章目录" description="从一个主题开始，找到相关笔记和题解。" eyebrow="CATALOG" variant="compact" />
  <main class="page-shell content-page" data-pagefind-ignore>
    <div class="content-page__head">
      <div><span class="section-kicker">TREE VIEW</span><h2>{articles.length} 篇文章</h2></div>
      <p>展开分类，查看其中的文章。</p>
    </div>
    <CatalogTree nodes={tree} />
  </main>
</BaseLayout>
