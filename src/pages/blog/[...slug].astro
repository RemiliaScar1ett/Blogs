---
import type { GetStaticPaths } from 'astro';
import ArticleView from '../../components/ArticleView.astro';
import { getArticles, relatedArticles, type ArticleEntry } from '../../lib/articles';
export const getStaticPaths = (async () => (await getArticles()).map((article) => ({ params: { slug: article.id }, props: { article } }))) satisfies GetStaticPaths;
interface Props { article: ArticleEntry }
const { article } = Astro.props;
const related = relatedArticles(article, await getArticles());
---
<ArticleView article={article} related={related} />
